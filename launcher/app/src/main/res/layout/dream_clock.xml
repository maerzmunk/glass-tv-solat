<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): a grey analog clock with the time and date beneath, drifting a little each
     minute, on the same grey as the clock's face. ClockDream adds the dial and sizes everything to the
     screen's height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1F1F22">

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dreamTimeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextClock
                android:id="@+id/dreamTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFD4D4D6"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false" />

            <!-- Top-aligned to the digits: ClockDream lines up the tops of the letters. -->
            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#FFB5B6B8"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8B8C90"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:includeFontPadding="false" />

        <!-- The day's prayer times, shown when prayer_times is on; the next one lighter and bold. -->
        <TextView
            android:id="@+id/dreamPrayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FF8B8C90"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.02"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
